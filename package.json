{
  "name": "star-frontier-threejs",
  "version": "1.0.0",
  "private": true,
  "description": "Star Frontier Three.js game runtime and Capacitor Android package",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "test": "node --test $(find src -type f -name '*.test.js' -print)",
    "android:add": "npx cap add android",
    "android:sync": "npx cap sync android",
    "build:earth:wasm": "bash scripts/build-earth-wasm.sh",
    "build:ship:wasm": "bash scripts/build-ship-flight-wasm.sh",
    "prepare:earth:etopo": "python3 scripts/prepare-etopo2022.py",
    "build:gravity:wasm": "bash scripts/build-gravity-wasm.sh"
  },
  "dependencies": {
    "@capacitor/core": "^7.4.3",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "@capacitor/android": "^7.4.3",
    "vite": "^6.4.1"
  }
}
